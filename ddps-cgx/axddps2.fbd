# the axisymmetric deep drawing finite element model
# this program is designed to be called by CalculiX cgx
#
# calling statement:
# cgx -b axddps2.fbd
#
# this is the first of the three CalculiX cgx scripts.
# the other scripts are consecutively named (numbered) 
# model geometry definitions consistent with TS 10525
# undertaken as part of  teknopro SEY lecture effort
# use the most generic and open creative commons license
#
# by fethio, Fethi Okyar, Ali Fethi Okyar, cc 2026

# bring plane normal to screen
frame
rot -z

# parameters
valu D1 33.  # diameter of Punch
valu R1	5.   # fillet radius of Punch
valu D2	34.255 # inner diameter of Die
valu  A  0.5  # thickness of Blank
valu R2	2.5   # fillet radius of D
valu DB	50.   # diameter of Blank
valu Nthk - 0 A
valu radp / D1 2.   # radius of Punch
valu rcpf - radp R1 # radial coor. of punch fillet arc center
valu radb / DB 2.  # radius of Blank    
valu radd / D2 2.  # radius inner of Die    
valu penh - radb radd # penetration height
valu rcdf + radd R2  # radial coor. of die fillet arc center
valu zcdf + A R2  # vertical offset of die fillet arc center
valu Nzcdf - 0 zcdf
valu zcdb + A penh # vertical offset of die bottom
valu Nzcdb - 0 zcdb
valu radh + A radd  # radius inner of Holder  
valu zcht * 4 A

# points
PNT PO 0.0 0.0 0.0
PNT P001 0.0 penh 0.0
PNT P002 radp penh 0.0
PNT P003 radp R1 0.0
PNT P004 rcpf R1 0.0
PNT P005 rcpf 0.0 0.0
PNT P011 radb 0.0 0.0
PNT P012 radb Nthk 0.0
PNT P013  0.0 Nthk 0.0
PNT P021 radh 0.0 0.0
PNT P022 radh zcht 0.0
PNT P023 radb zcht 0.0
PNT P031 rcdf Nthk  0.0
PNT P032 rcdf Nzcdf 0.0
PNT P033 radd Nzcdf 0.0
PNT P034 radd Nzcdb 0.0
PNT P035 radb Nzcdb 0.0

# edge divisions
valu dqca 4	
valu dblh 20	
valu dblv 4	

# geometry punch
LINE L001 PO P005
LINE L002 P005 P003 P004 dqca
LINE L003 P003 P002
LINE L004 P002 P001
LINE L005 P001 PO
SETO geom_punch
gsur A001 + BLEND + L001 + L002 + L003 + L004 + L005
SETC geom_punch

# geometry blank
LINE L011 PO   P013 dblv
LINE L012 P013 P012 dblh
LINE L013 P012 P011 dblv
LINE L014 P011 PO   dblh
SETO geom_blank
gsur A002 + BLEND + L011 + L012 + L013 + L014
SETC geom_blank

# geometry holder
LINE L021 P021 P011
LINE L022 P011 P023
LINE L023 P023 P022
LINE L024 P022 P021
SETO geom_holder
gsur A003 + BLEND + L021 + L022 + L023 + L024
SETC geom_holder

# geometry die
LINE L031 P012 P031
LINE L032 P031 P033 P032 dqca
LINE L033 P033 P034
LINE L034 P034 P035
LINE L035 P035 P012
SETO geom_die
gsur A004 + BLEND + L031 + L032 + L033 + L034 + L035
# trial of complementing a set with lower entities
comp geom_die do

SETC geom_die
# to see the nodes (n) and faces (f) in a set use
# plot n geom_die
# plot f geom_die

# plot n geom_die
# plus f geom_die b


# mesh the objects
ELTY all qu8
MESH all

# create the interaction sets
seta punch_b_surf l L001 L002 L003  # punch's edge entities with blank (includes inner nodes)
comp punch_b_surf do  # to include bounding nodes
# to plot this use: `plus n punch_b_surf`
seta blank_top l L014  # blank's top surface
comp blank_top do
