awk '
FNR==NR {
    if (/TOTAL TIME COMPLETED/) t = $4
    if (/total force \(fx,fy,fz\) for set NBASE_PLATE_CENTER_YFIX/) {
        if ((getline) > 0 && (getline) > 0 && NF == 3) {
            k = sprintf("%.6f", t + 0)
            fy[k] = $2
            fz[k] = $3
        }
    }
    next
}
/TOT TIME/ && !/RFY/ { print $0 "   RFY   RFZ"; next }
$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ && NF >= 7 {
    k = sprintf("%.6f", $5 + 0)
    if (k in fy)
        print $0 "   " fy[k] "   " fz[k]
    else {
        print $0
        printf("warning: no force record for total time %s (inc %s)\n", $5, $2) > "/dev/stderr"
    }
    next
}
{ print }
' solve_S4_e3_128.dat solve_S4_e3_128.sta > S4_e3_128_ss-2.dat