frame
rot -z

# Parameters
valu D 3255.
valu R / D 2.
valu H 10667.5
valu Ncirc 100
valu Nheight 60

# --------------------------------------------------
# Vertical generator on the cylinder surface
# --------------------------------------------------

PNT PBASE R 0. 0.
PNT PTOP  R 0. H

LINE LGEN PBASE PTOP Nheight

SETA generator l LGEN

# --------------------------------------------------
# Rotate the generator around the Z axis
# through 360 degrees to create the cylindrical surface
# --------------------------------------------------

SETO cylinder
SWEP generator cylinder ROT z 360. Ncirc
# Merge coincident nodes at the seam
MERGE N all
SETC cylinder


# --------------------------------------------------
# Mesh the cylindrical shell
# ------------------------------------------------# Mesh
ELTY all QU8
MESH all


# Select all nodes
SETA cylinder N all

# Select nodes at the bottom elevation, z = 0
enq cylinder base_plate_center_YFIX rec _ _ 0.0 0.1 a

enq cylinder skir_sless_top_LOAD rec _ _ 10667.5 0.1 a
#
# --------------------------------------------------
# Export mesh and named node sets
#
--------------------------------------------------
send all abq
send skir_sless_top_LOAD abq nam
send base_plate_center_YFIX abq nam

# End